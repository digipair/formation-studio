{
  "description": "List the objects of any GLPI item type (Computer, User, Software, ...).",
  "summary": "List items",
  "library": "@digipair/skill-worker",
  "element": "action",
  "metadata": {
    "context": false,
    "parameters": [
      {
        "name": "itemtype",
        "summary": "Item type",
        "required": true,
        "description": "GLPI item type to list (e.g. Computer, User, Software)",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "range",
        "summary": "Range",
        "required": false,
        "description": "Result range in GLPI format (e.g. 0-49). Defaults to 0-49.",
        "schema": {
          "type": "string"
        }
      }
    ],
    "prompts": [
      {
        "title": "List items",
