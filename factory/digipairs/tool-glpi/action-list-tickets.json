{
  "description": "Liste les tickets du helpdesk GLPI.",
  "summary": "List tickets",
  "library": "@digipair/skill-tool",
  "element": "action",
  "metadata": {
    "parameters": [
      {
        "name": "range",
        "summary": "Plage",
        "required": false,
        "description": "Plage de résultats au format GLPI (ex: 0-49). 0-49 par défaut.",
        "schema": {
          "type": "string"
        }
      }
    ],
    "output": {
      "type": "array",
      "description": "Liste des tickets",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "properties": {
    "execute": [
      {
        "library": "digipair:tool-glpi",
        "element": "action-request",
        "properties": {
          "endpoint": "/Ticket",
          "method": "GET",
          "query": "FEEL: \"range=\" + (if request.body.range != null and request.body.range != \"\" then request.body.range else \"0-49\")"
        }
      }
    ]
  },
  "pins": []
}
