{
  "description": "Liste les tickets (issues) d'un projet Taiga.",
  "summary": "List issues",
  "library": "@digipair/skill-tool",
  "element": "action",
  "metadata": {
    "parameters": [
      {
        "name": "project",
        "summary": "Projet",
        "required": true,
        "description": "Identifiant du projet",
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "query",
        "summary": "Filtres",
        "required": false,
        "description": "Filtres additionnels au format query string Taiga (ex: status=1)",
        "schema": {
          "type": "string"
        }
      }
    ],
    "output": {
      "type": "array",
      "description": "Liste des issues",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "properties": {
    "execute": [
      {
        "library": "digipair:tool-taiga",
        "element": "action-request",
        "properties": {
          "endpoint": "/issues",
          "method": "GET",
          "query": "FEEL: \"project=\" + string(request.body.project) + (if request.body.query != null and request.body.query != \"\" then \"&\" + request.body.query else \"\")"
        }
      }
    ]
  },
  "pins": []
}
